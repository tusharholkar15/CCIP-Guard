FROM node:20-alpine AS base
RUN apk add --no-cache git openssh && npm install -g pnpm@9.4.0
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/workers/ ./apps/workers/

RUN pnpm config set fetch-retries 5 && pnpm install --filter @bridgeguard/workers...
RUN pnpm --filter @bridgeguard/workers... build

CMD ["node", "apps/workers/dist/alerts.js"]

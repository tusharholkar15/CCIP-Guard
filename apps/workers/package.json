{
  "name": "@bridgeguard/workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"npm:dev:*\"",
    "dev:metrics": "tsx watch src/metrics.ts",
    "dev:alerts": "tsx watch src/alerts.ts",
    "dev:responses": "tsx watch src/responses.ts",
    "start:metrics": "node dist/metrics.js",
    "start:alerts": "node dist/alerts.js",
    "start:responses": "node dist/responses.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bridgeguard/database": "workspace:*",
    "@bridgeguard/redis": "workspace:*",
    "@bridgeguard/shared": "workspace:*",
    "bullmq": "^5.8.0",
    "drizzle-orm": "^0.31.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}

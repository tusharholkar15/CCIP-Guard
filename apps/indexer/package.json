    "@bridgeguard/redis": "workspace:*",
    "@bridgeguard/shared": "workspace:*",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.31.0",
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}

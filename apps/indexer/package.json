{
  "name": "@bridgeguard/indexer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/indexer.ts",
    "start": "node dist/indexer.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",

# Environment
ENVIRONMENT=mainnet
NEXT_PUBLIC_ENVIRONMENT=mainnet

# Database
DATABASE_URL=postgresql://bridgeguard:bridgeguard@localhost:5432/bridgeguard

# Redis
REDIS_URL=redis://localhost:6379

# Mainnet RPC Endpoints (Public endpoints suitable for read-only indexer)
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
BNB_RPC_URL=https://bsc-dataseed.binance.org

# API
API_PORT=3001
API_KEY=your-api-key-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# CCIP Mainnet Router Addresses (Read-only reference)
ETHEREUM_CCIP_ROUTER_ADDRESS=0x80226fc0Ee2b096224EeAc085Bb9a8cba1146f7D
ARBITRUM_CCIP_ROUTER_ADDRESS=0x141fa059441E0ca23ce184B6A78bafD2A517DdE8
